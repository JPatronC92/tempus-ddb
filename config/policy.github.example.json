{
  "schema_version": "tempus.policy-bundle.v1",
  "policy_version": "acme-github-v1",
  "tenant_id": "acme",
  "constraints": {
    "allowed_action_types": [
      "github.create_issue",
      "github.create_pull_request"
    ],
    "allowed_resources": [
      "acme/*"
    ],
    "allowed_executors": [
      "REPLACE_WITH_EXECUTOR_ED25519_PUBLIC_KEY"
    ],
    "max_ttl_seconds": 60,
    "max_input_bytes": 16384,
    "allowed_currencies": [
      "USD"
    ]
  }
}
